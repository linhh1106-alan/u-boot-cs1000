# line: 36, file: /work/poky/meta/recipes-bsp/u-boot/u-boot.inc
do_compile() {
    if [ "" ]; then
        sed -i 's/$(CROSS_COMPILE)ld$/$(CROSS_COMPILE)ld.bfd/g' /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git/config.mk
    fi

    unset LDFLAGS
    unset CFLAGS
    unset CPPFLAGS

    if [ ! -e /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/.scmversion -a ! -e /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git/.scmversion ]
    then
        echo  > /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/.scmversion
        echo  > /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git/.scmversion
    fi

    if [ -n "EFI" -o -n "${UBOOT_DELTA_CONFIG}" ]
    then
        unset i j k
        for config in  corstone1000_defconfig; do
            i=$(expr $i + 1);
            for type in EFI; do
                j=$(expr $j + 1);
                if [ $j -eq $i ]
                then
                    oe_runmake -C /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git O=/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config} all
                    for binary in  u-boot.bin; do
                        k=$(expr $k + 1);
                        if [ $k -eq $i ]; then
                            cp /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/${binary} /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-${type}.bin
                        fi
                    done

                    # Generate the uboot-initial-env
                    if [ -n "u-boot-initial-env" ]; then
                        oe_runmake -C /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git O=/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config} u-boot-initial-env
                        cp /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-initial-env /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-initial-env-${type}
                    fi

                    unset k
                fi
            done
            unset j
        done
        unset i
    else
        oe_runmake -C /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git O=/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build all

        # Generate the uboot-initial-env
        if [ -n "u-boot-initial-env" ]; then
            oe_runmake -C /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/git O=/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build u-boot-initial-env
        fi
    fi

    if [ -n "" ] && [ "txt" = "scr" ]
    then
        uboot-mkimage -C none -A arm64 -T script -d /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/.cmd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/.txt
    fi
}

