# line: 222, file: /work/poky/meta/classes-recipe/uboot-sign.bbclass
install_helper() {
	if [ -f "u-boot.dtb" ]; then
		# UBOOT_DTB_BINARY is a symlink to UBOOT_DTB_IMAGE, so we
		# need both of them.
		install -Dm 0644 u-boot.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/usr/share/u-boot-corstone1000-fvp-2022.07-r0.dtb
		ln -sf u-boot-corstone1000-fvp-2022.07-r0.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/usr/share/u-boot.dtb
	else
		bbwarn "u-boot.dtb not found"
	fi
}

# line: 234, file: /work/poky/meta/classes-recipe/uboot-sign.bbclass
install_spl_helper() {
	if [ -f "spl/u-boot-spl.dtb" ]; then
		install -Dm 0644 spl/u-boot-spl.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/usr/share/u-boot-spl-corstone1000-fvp-2022.07-r0.dtb
		ln -sf u-boot-spl-corstone1000-fvp-2022.07-r0.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/usr/share/u-boot-spl.dtb
	else
		bbwarn "u-boot-spl.dtb not found"
	fi
	if [ -f "u-boot-nodtb.bin" ] ; then
		install -Dm 0644 u-boot-nodtb.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/usr/share/u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin
		ln -sf u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/usr/share/u-boot-nodtb.bin
	else
		bbwarn "u-boot-nodtb.bin not found"
	fi

	# We need to install a 'stub' u-boot-fitimage + its to datadir,
	# so that the KERNEL_PN can use the correct filename when
	# assembling and deploying them
	touch /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//usr/share/u-boot-fitImage-corstone1000-fvp-2022.07-r0
	touch /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//usr/share/u-boot-its-corstone1000-fvp-2022.07-r0
}

# line: 38, file: /work/poky/meta/classes-global/logging.bbclass
bbwarn() {
	if [ -p /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/temp/fifo.10390 ] ; then
		printf "%b\0" "bbwarn $*" > /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/temp/fifo.10390
	else
		echo "WARNING: $*"
	fi
}

cd '/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build'
do_install

# cleanup
ret=$?
trap '' 0
exit $ret
