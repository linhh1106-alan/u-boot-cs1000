# line: 95, file: /work/poky/meta/recipes-bsp/u-boot/u-boot.inc
do_install() {
    if [ -n "EFI" ]
    then
        for config in  corstone1000_defconfig; do
            i=$(expr $i + 1);
            for type in EFI; do
                j=$(expr $j + 1);
                if [ $j -eq $i ]
                then
                    install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-${type}.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot-${type}-2022.07-r0.bin
                    ln -sf u-boot-${type}-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot.bin-${type}
                    ln -sf u-boot-${type}-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot.bin

                    # Install the uboot-initial-env
                    if [ -n "u-boot-initial-env" ]; then
                        install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-initial-env-${type} /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0
                        ln -sf u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env-corstone1000-fvp-${type}
                        ln -sf u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env-${type}
                        ln -sf u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env
                    fi
                fi
            done
            unset j
        done
        unset i
    else
        install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/u-boot.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot-corstone1000-fvp-2022.07-r0.bin
        ln -sf u-boot-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot.bin

        # Install the uboot-initial-env
        if [ -n "u-boot-initial-env" ]; then
            install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/u-boot-initial-env /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env-corstone1000-fvp-2022.07-r0
            ln -sf u-boot-initial-env-corstone1000-fvp-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env-corstone1000-fvp
            ln -sf u-boot-initial-env-corstone1000-fvp-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image//etc/u-boot-initial-env
        fi
    fi

    if [ -n "" ]
    then
        if [ -n "EFI" ]
        then
            for config in  corstone1000_defconfig; do
                i=$(expr $i + 1);
                for type in EFI; do
                    j=$(expr $j + 1);
                    if [ $j -eq $i ]
                    then
                        install -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/ /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot-${type}-2022.07-r0.elf
                        ln -sf u-boot-${type}-2022.07-r0.elf /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot.bin-${type}
                        ln -sf u-boot-${type}-2022.07-r0.elf /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot.bin
                    fi
                done
                unset j
            done
            unset i
        else
            install -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/ /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot-corstone1000-fvp-2022.07-r0.elf
            ln -sf u-boot-corstone1000-fvp-2022.07-r0.elf /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/image/boot/u-boot.elf
        fi
    fi

    if [ -e /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/fw_env.config ] ; then
