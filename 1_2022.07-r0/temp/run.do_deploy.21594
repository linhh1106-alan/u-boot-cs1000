# line: 185, file: /work/poky/meta/classes-recipe/uboot-sign.bbclass
concat_dtb() {
	if [ "0" = "1" -a "u-boot" = "u-boot" -a -n "u-boot.dtb" ]; then
		mkdir -p /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
		if [ -n "EFI" ]; then
			for config in  corstone1000_defconfig; do
				CONFIG_B_PATH="$config"
				cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/$config
				concat_dtb_helper
			done
		else
			CONFIG_B_PATH=""
			cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build
			concat_dtb_helper
		fi
	fi
}

