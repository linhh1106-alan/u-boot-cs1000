# line: 212, file: /work/poky/meta/recipes-bsp/u-boot/u-boot.inc
do_deploy() {
	if [ "0" = "1" -a -n "u-boot.dtb" ] ; then
		concat_dtb
	fi

	if [ "0" = "1" ] ; then
	# Deploy the u-boot-nodtb binary and symlinks...
		if [ -f "spl/u-boot-spl-nodtb.bin" ] ; then
			echo "Copying u-boot-nodtb binary..."
			install -m 0644 spl/u-boot-spl-nodtb.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-spl-nodtb-corstone1000-fvp-2022.07-r0.bin
			ln -sf u-boot-spl-nodtb-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-spl-nodtb-corstone1000-fvp.bin
			ln -sf u-boot-spl-nodtb-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-spl-nodtb.bin
		fi


		# We only deploy the symlinks to the uboot-fitImage and uboot-its
		# images, as the KERNEL_PN will take care of deploying the real file
		ln -sf u-boot-fitImage-corstone1000-fvp-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-fitImage
		ln -sf u-boot-fitImage-corstone1000-fvp-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-fitImage-corstone1000-fvp
		ln -sf u-boot-its-corstone1000-fvp-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot.its
		ln -sf u-boot-its-corstone1000-fvp-2022.07-r0 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-its-corstone1000-fvp
	fi

	if [ "0" = "1" -a -n "u-boot-spl.dtb" ] ; then
		concat_spl_dtb
	fi


    if [ -n "EFI" ]
    then
        for config in  corstone1000_defconfig; do
            i=$(expr $i + 1);
            for type in EFI; do
                j=$(expr $j + 1);
                if [ $j -eq $i ]
                then
                    install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-${type}.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-${type}-2022.07-r0.bin
                    cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
                    ln -sf u-boot-${type}-2022.07-r0.bin u-boot-corstone1000-fvp.bin-${type}
                    ln -sf u-boot-${type}-2022.07-r0.bin u-boot-corstone1000-fvp.bin
                    ln -sf u-boot-${type}-2022.07-r0.bin u-boot.bin-${type}
                    ln -sf u-boot-${type}-2022.07-r0.bin u-boot.bin

                    # Deploy the uboot-initial-env
                    if [ -n "u-boot-initial-env" ]; then
                        install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${config}/u-boot-initial-env-${type} /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0
                        cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
                        ln -sf u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0 u-boot-initial-env-corstone1000-fvp-${type}
                        ln -sf u-boot-initial-env-corstone1000-fvp-${type}-2022.07-r0 u-boot-initial-env-${type}
                    fi
                fi
            done
            unset j
        done
        unset i
    else
        install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/u-boot.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-corstone1000-fvp-2022.07-r0.bin

        cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
        rm -f u-boot.bin u-boot-corstone1000-fvp.bin
        ln -sf u-boot-corstone1000-fvp-2022.07-r0.bin u-boot-corstone1000-fvp.bin
        ln -sf u-boot-corstone1000-fvp-2022.07-r0.bin u-boot.bin

        # Deploy the uboot-initial-env
        if [ -n "u-boot-initial-env" ]; then
            install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/u-boot-initial-env /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-initial-env-corstone1000-fvp-2022.07-r0
            cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
            ln -sf u-boot-initial-env-corstone1000-fvp-2022.07-r0 u-boot-initial-env-corstone1000-fvp
            ln -sf u-boot-initial-env-corstone1000-fvp-2022.07-r0 u-boot-initial-env
        fi
    fi

    if [ -e /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/fw_env.config ] ; then
        install -D -m 644 /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/fw_env.config /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/fw_env.config-corstone1000-fvp-2022.07-r0
        cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
        ln -sf fw_env.config-corstone1000-fvp-2022.07-r0 fw_env.config-corstone1000-fvp
        ln -sf fw_env.config-corstone1000-fvp-2022.07-r0 fw_env.config
    fi

    if [ -n "" ]
    then
        if [ -n "EFI" ]
        then
            for config in  corstone1000_defconfig; do
                i=$(expr $i + 1);
                for type in EFI; do
                    j=$(expr $j + 1);
                    if [ $j -eq $i ]
                    then
