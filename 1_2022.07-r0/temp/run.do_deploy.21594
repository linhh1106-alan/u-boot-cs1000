# line: 119, file: /work/poky/meta/classes-recipe/uboot-sign.bbclass
concat_dtb_helper() {
	if [ -e "u-boot.dtb" ]; then
		ln -sf u-boot-corstone1000-fvp-2022.07-r0.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot.dtb
		ln -sf u-boot-corstone1000-fvp-2022.07-r0.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-corstone1000-fvp.dtb
	fi

	if [ -f "u-boot-nodtb.bin" ]; then
		install u-boot-nodtb.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin
		ln -sf u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-nodtb-corstone1000-fvp.bin
		ln -sf u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-nodtb.bin
	fi

	# If we're not using a signed u-boot fit, concatenate SPL w/o DTB & U-Boot DTB
	# with public key (otherwise it will be deployed by the equivalent
	# concat_spl_dtb_helper function - cf. kernel-fitimage.bbclass for more details)
	if [ "0" != "1" ] ; then
		deployed_uboot_dtb_binary='/work/build-cs1000/tmp/deploy/images/corstone1000-fvp/u-boot-corstone1000-fvp-2022.07-r0.dtb'
		if [ "xbin" = "ximg" -o "xbin" = "xrom" ] && \
			[ -e "$deployed_uboot_dtb_binary" ]; then
			oe_runmake EXT_DTB=$deployed_uboot_dtb_binary
			install u-boot.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-corstone1000-fvp-2022.07-r0.bin
		elif [ -e "/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin" -a -e "$deployed_uboot_dtb_binary" ]; then
			cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
			cat u-boot-nodtb-corstone1000-fvp-2022.07-r0.bin $deployed_uboot_dtb_binary | tee /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${CONFIG_B_PATH}/u-boot.bin > u-boot-corstone1000-fvp-2022.07-r0.bin

			if [ -n "EFI" ]
			then
				i=0
				j=0
				for config in  corstone1000_defconfig; do
					i=$(expr $i + 1);
					for type in EFI; do
						j=$(expr $j + 1);
						if [ $j -eq $i ]
						then
							cp u-boot-corstone1000-fvp-2022.07-r0.bin /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${CONFIG_B_PATH}/u-boot-$type.bin
						fi
					done
				done
			fi
		else
			bbwarn "Failure while adding public key to u-boot binary. Verified boot won't be available."
		fi
	fi
}

# line: 165, file: /work/poky/meta/classes-recipe/uboot-sign.bbclass
concat_spl_dtb_helper() {

	# We only deploy symlinks to the u-boot-spl.dtb,as the KERNEL_PN will
	# be responsible for deploying the real file
	if [ -e "spl/u-boot-spl.dtb" ] ; then
		ln -sf u-boot-spl-corstone1000-fvp-2022.07-r0.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-spl-corstone1000-fvp.dtb
		ln -sf u-boot-spl-corstone1000-fvp-2022.07-r0.dtb /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-spl.dtb
	fi

	# Concatenate the SPL nodtb binary and u-boot.dtb
	deployed_spl_dtb_binary='/work/build-cs1000/tmp/deploy/images/corstone1000-fvp/u-boot-spl-corstone1000-fvp-2022.07-r0.dtb'
	if [ -e "/work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot/u-boot-spl-nodtb-corstone1000-fvp-2022.07-r0.bin" -a -e "$deployed_spl_dtb_binary" ] ; then
		cd /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/deploy-u-boot
		cat u-boot-spl-nodtb-corstone1000-fvp-2022.07-r0.bin $deployed_spl_dtb_binary | tee /work/build-cs1000/tmp/work/corstone1000_fvp-poky-linux-musl/u-boot/1_2022.07-r0/build/${CONFIG_B_PATH}/ > -corstone1000-fvp-2022.07-r0
	else
		bbwarn "Failure while adding public key to spl binary. Verified U-Boot boot won't be available."
	fi
}

